doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title NNチャットの入口
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet")
  body(
    data-bs-theme=currentTheme
    class=currentTheme === 'light' ? 'bg-warning bg-gradient min-vh-100' : 'min-vh-100'
  )
    .container.py-5
      .row.justify-content-center
        .col-md-8.col-lg-6
          //- 上部バー（テーマ切替・ログアウト）
          .d-flex.justify-content-end.mb-3
            .dropdown
              button#menu.btn.btn-sm.rounded-pill.px-3.shadow-sm.fw-bold.dropdown-toggle(
                type="button"
                class=currentTheme === 'light' ? 'btn-light' : 'btn-outline-light'
                data-bs-toggle="dropdown"
                aria-expanded="false"
              )
                i.bi.bi-palette-fill.me-1
                | メニュー
              ul.dropdown-menu.dropdown-menu-end.shadow-sm(aria-labelledby="menu")
                li
                  a.dropdown-item(href="/changeTheme")
                    if currentTheme === 'light'
                      i.bi.bi-moon-stars-fill.me-2
                      | ダークモードにする
                    else
                      i.bi.bi-sun-fill.text-warning.me-2
                      | ライトモードにする


          //- メインカード
          .card.shadow-sm.border-0
            .card-body.p-4.p-md-5.text-center
              h1.fw-bold.mb-2 NNチャットの入口
              p.mb-4(class=currentTheme === 'light' ? 'text-dark opacity-75' : 'text-body-secondary')
                | チャットルームへ移動するか、セッションを終了できます。
              .d-grid.gap-3.col-sm-8.mx-auto
                a.btn.btn-success.btn-lg(href="/posts")
                  i.bi.bi-chat-dots-fill.me-2
                  | NNチャットへ進む
                a.btn.btn-outline-secondary(href="/logout")
                  i.bi.bi-box-arrow-right.me-2
                  | ログアウト

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")