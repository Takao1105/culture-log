doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title CULTURE LOG
    link(rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2285%22>📚</text></svg>")
    //- Bootstrap 5 CSS
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    //- Bootstrap Icons
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet")
    style.
      .star-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 4px;
      }
      .star-rating input {
        display: none;
      }
      .star-rating label {
        font-size: 2rem;
        line-height: 1;
        color: #dee2e6;
        cursor: pointer;
        transition: color 0.15s ease-in-out;
      }
      [data-bs-theme="dark"] .star-rating label {
        color: #495057;
      }
      .star-rating input:checked ~ label,
      .star-rating label:hover,
      .star-rating label:hover ~ label {
        color: #ffc107;
      }

  body(
    data-bs-theme=currentTheme
    class=currentTheme === 'light' ? 'bg-warning bg-gradient' : ''
  )
    .container.py-4
      .row.justify-content-center
        .col-md-8.col-lg-6
          //- 上部バー（右端にユーザードロップダウンを配置）
          .d-flex.justify-content-end.mb-2
            .dropdown
              button#menu.btn.btn-sm.rounded-pill.px-3.shadow-sm.fw-bold.dropdown-toggle(
                type="button"
                class=currentTheme === 'light' ? 'btn-light' : 'btn-outline-light'
                data-bs-toggle="dropdown"
                aria-expanded="false"
              )
                if user === 'admin'
                  i.bi.bi-gear-fill.me-1
                else
                  i.bi.bi-person-circle.me-1
                | #{user}
              ul.dropdown-menu.dropdown-menu-end.shadow-sm(aria-labelledby="menu")
                li
                  a.dropdown-item(href="/changeTheme")
                    if currentTheme === 'light'
                      i.bi.bi-moon-stars-fill.me-2
                      | ダークモードにする
                    else
                      i.bi.bi-sun-fill.text-warning.me-2
                      | ライトモードにする
                li
                  hr.dropdown-divider
                li
                  a.dropdown-item.text-danger(href="/logout")
                    i.bi.bi-box-arrow-right.me-2
                    | ログアウト

          //- ヘッダー
          .d-flex.align-items-center.justify-content-center.gap-3.mb-4
            img.rounded.shadow-sm(
              src=logoUrl
              alt="CULTURE LOG ロゴ画像"
              style="width: 120px; height: 120px; object-fit: cover;"
            )
            .text-start
              h1.fw-bold.mb-1 CULTURE LOG
              p.mb-2(class=currentTheme === 'light' ? 'text-dark opacity-75' : 'text-body-secondary')
                | ZEN大学生専用：映画と本の記録を残そう
              span.badge.bg-dark.bg-opacity-75.text-white.rounded-pill.px-3.py-1
                i.bi.bi-eye.me-1
                | 累計アクセス: #{String(accessCount).padStart(6, '0')} 回

          //- フォームカード
          .card.shadow-sm.border-0
            .card-body.p-4
              form(method="post" action="/posts")
                input(type="hidden" name="oneTimeToken" value=oneTimeToken)
                .mb-3
                  label.form-label.fw-bold(for="category") カテゴリ
                  select#category.form-select(name="category" required)
                    option(value="" disabled selected) 選択してください
                    option(value="book") 本
                    option(value="movie") 映画

                .mb-3
                  label.form-label.fw-bold.d-block おすすめ度
                  .star-rating
                    input#star5(type="radio" name="rating" value="5" required)
                    label(for="star5") ★
                    input#star4(type="radio" name="rating" value="4")
                    label(for="star4") ★
                    input#star3(type="radio" name="rating" value="3")
                    label(for="star3") ★
                    input#star2(type="radio" name="rating" value="2")
                    label(for="star2") ★
                    input#star1(type="radio" name="rating" value="1")
                    label(for="star1") ★

                .mb-3
                  label.form-label.fw-bold(for="title") タイトル
                  input#title.form-control(type="text" name="title" required placeholder="作品名を入力")

                .mb-3
                  label.form-label.fw-bold(for="author") 著者・監督
                  input#author.form-control(type="text" name="author" placeholder="著者名または監督名")

                .mb-4
                  label.form-label.fw-bold(for="content") コメント
                  textarea#content.form-control(name="content" rows="4" required placeholder="感想を入力してください")

                .d-grid
                  button.btn.btn-success.btn-lg(type="submit")
                    | 投稿
                    i.bi.bi-chat-dots-fill.ms-1

          //- ▼ 投稿一覧
          .mt-5
            h2.h4.fw-bold.mb-3 投稿一覧
            if contents && contents.length > 0
              each post in contents
                .card.shadow-sm.border-0.mb-3
                  .card-body
                    .d-flex.justify-content-between.align-items-center.mb-2
                      if post.category === 'book'
                        span.badge.bg-primary 📚 本
                      else
                        span.badge.bg-danger 🎬 映画
                      span.text-warning.fw-bold #{'★'.repeat(Number(post.rating))}
                    h5.card-title.fw-bold.mb-1 #{post.title}
                    if post.author
                      h6.card-subtitle.text-body-secondary.small.mb-2 #{post.author}
                    p.card-text.mb-3(style="white-space: pre-wrap;") #{post.content}
                    .d-flex.justify-content-between.align-items-center.border-top.pt-2
                      small.text-body-secondary
                        if post.postedBy === 'admin'
                          i.bi.bi-gear-fill.me-1
                        else
                          i.bi.bi-person-circle.me-1
                        | #{post.postedBy}
                      .d-flex.align-items-center.gap-3
                        - const tooltipTitle = `<small>${post.absoluteCreatedAt}</small>`
                        small.text-body-secondary(
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          data-bs-html="true"
                          title=tooltipTitle
                          style="cursor: pointer;"
                        ) #{post.relativeCreatedAt}
                        if user === post.postedBy || user === 'admin'
                          form.m-0(method="post" action="/posts/delete")
                            input(type="hidden" name="id" value=post.id)
                            input(type="hidden" name="oneTimeToken" value=oneTimeToken)
                            button.btn.btn-outline-danger.btn-sm(type="submit")
                              i.bi.bi-trash.me-1
                              | 削除
            else
              p(class=currentTheme === 'light' ? 'text-dark opacity-75' : 'text-body-secondary')
                | まだ投稿がありません。

    //- ▼ Bootstrap 5 JS
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script.
      const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
      [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));